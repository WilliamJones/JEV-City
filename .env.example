# Copy to .env.local and fill in. Values here are placeholders only.

# OpenRouter (conventional LLM baseline engine)
OPENROUTER_API_KEY=

# TypeSafe JEV direct API (JEV decision engine)
TYPESAFE_API_KEY=

# Live mode (server-side). Public deployments default to replay; live needs the passcode.
JEV_LIVE_ENABLED=false
JEV_LIVE_PASSCODE=
# Documented tariff for token-based cost estimates (docs.typesafe.ai/models, verified 2026-10-13)
JEV_PRICE_INPUT_PER_MTOK=0.042
JEV_PRICE_OUTPUT_PER_MTOK=0
# Shared budget store (Vercel Upstash/KV integration). Required for live mode in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JEV_DAILY_CAP=3000
